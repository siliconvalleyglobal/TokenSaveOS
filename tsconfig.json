{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@tokensaveos/core": ["./packages/core/dist/index.d.ts"],
      "@tokensaveos/context-engine": ["./packages/context-engine/dist/index.d.ts"],
      "@tokensaveos/token-engine": ["./packages/token-engine/dist/index.d.ts"],
      "@tokensaveos/cache-manager": ["./packages/cache-manager/dist/index.d.ts"],
      "@tokensaveos/memory-engine": ["./packages/memory-engine/dist/index.d.ts"],
      "@tokensaveos/agent-router": ["./packages/agent-router/dist/index.d.ts"],
      "@tokensaveos/eval-harness": ["./packages/eval-harness/dist/index.d.ts"],
      "@tokensaveos/skill-manager": ["./packages/skill-manager/dist/index.d.ts"],
      "@tokensaveos/mcp-server": ["./packages/mcp-server/dist/index.d.ts"],
      "@tokensaveos/ast-trimmer": ["./packages/ast-trimmer/dist/index.d.ts"],
      "@tokensaveos/cost-matrix": ["./packages/cost-matrix/dist/index.d.ts"],
      "@tokensaveos/token-sentinel": ["./packages/token-sentinel/dist/index.d.ts"],
      "@tokensaveos/prompt-cache": ["./packages/prompt-cache/dist/index.d.ts"],
      "@tokensaveos/semantic-cache": ["./packages/semantic-cache/dist/index.d.ts"],
      "@tokensaveos/output-compressor": ["./packages/output-compressor/dist/index.d.ts"],
      "@tokensaveos/budget-circuit-breaker": ["./packages/budget-circuit-breaker/dist/index.d.ts"],
      "@tokensaveos/loop-detector": ["./packages/loop-detector/dist/index.d.ts"],
      "@tokensaveos/multi-modal-tokens": ["./packages/multi-modal-tokens/dist/index.d.ts"],
      "@tokensaveos/streaming-optimizer": ["./packages/streaming-optimizer/dist/index.d.ts"],
      "@tokensaveos/memory-dedup": ["./packages/memory-dedup/dist/index.d.ts"],
      "@tokensaveos/batch-router": ["./packages/batch-router/dist/index.d.ts"],
      "@tokensaveos/prompt-versioning": ["./packages/prompt-versioning/dist/index.d.ts"],
      "@tokensaveos/token-forecaster": ["./packages/token-forecaster/dist/index.d.ts"]
    }
  },
  "exclude": ["tests/**/*", "**/*.test.ts", "**/dist/**/*"]
}
