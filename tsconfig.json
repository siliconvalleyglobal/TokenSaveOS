{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tokensaveos/core": ["packages/core/dist/index.d.ts"],
      "@tokensaveos/context-engine": ["packages/context-engine/dist/index.d.ts"],
      "@tokensaveos/token-engine": ["packages/token-engine/dist/index.d.ts"],
      "@tokensaveos/cache-manager": ["packages/cache-manager/dist/index.d.ts"],
      "@tokensaveos/memory-engine": ["packages/memory-engine/dist/index.d.ts"],
      "@tokensaveos/agent-router": ["packages/agent-router/dist/index.d.ts"],
      "@tokensaveos/eval-harness": ["packages/eval-harness/dist/index.d.ts"],
      "@tokensaveos/skill-manager": ["packages/skill-manager/dist/index.d.ts"],
      "@tokensaveos/mcp-server": ["packages/mcp-server/dist/index.d.ts"],
      "@tokensaveos/ast-trimmer": ["packages/ast-trimmer/dist/index.d.ts"],
      "@tokensaveos/cost-matrix": ["packages/cost-matrix/dist/index.d.ts"],
      "@tokensaveos/token-sentinel": ["packages/token-sentinel/dist/index.d.ts"]
    }
  },
  "exclude": ["tests/**/*", "**/*.test.ts", "**/dist/**/*"]
}
